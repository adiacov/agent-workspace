.vscode/
.idea/

# Transient handoff outbox (delivered downstream, not project history)
HANDOFF.md

# Local/private identity or secrets
LOCAL.md
PRIVATE.md
secrets/
*.pem
*.key

# Pi project config: track checkpoint settings, ignore other local Pi files
.pi/*
!.pi/
!.pi/checkpoint.json

# Raw agent/session evidence may contain sensitive conversation
sessions/pending/*.md
sessions/archive/*.md

# Optional private durable memory or local decision notes
MEMORY.md
DECISIONS.local.md

# Internal working notes / design reports (for us, not shipped or committed)
reports/
.agent-workspace/baseline/
*.bak
*.merge
